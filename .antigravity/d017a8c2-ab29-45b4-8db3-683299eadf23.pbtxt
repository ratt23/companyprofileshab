  file_change {
    absolute_path_uri: "file:///src/components/SlidePlan.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { motion } from \"motion/react\";\nimport { CalendarRange, Sparkle, ArrowRight, ShieldCheck, Milestone } from \"lucide-react\";\n\nexport function SlidePlan() {\n  const [activePlanIdx, setActivePlanIdx] = useState(0);\n\n  const plans = [\n    {\n      year: \"2025\",\n      id: \"p2025\",\n      title: \"Kamar Rawat Inap, Executive, & Care Units\",\n      points: [\n        \"Kamar Rawat Inap: perluasan dan penambahan kapasitas tempat tidur menjadi total 145 Bed secara keseluruhan.\",\n        \"Aktivasi penuh Layanan Executive Clinic terpadu berfasilitas premium.\",\n        \"Peningkatan standar ICU + NICU dengan penambahan modalitas alat ventilasi modern dan inkubator inklusif.\"\n      ],\n      tagline: \"Fase Ekspansi Ruang & Kapasitas Dasar\"\n    },\n    {\n      year: \"2026\",\n      id: \"p2026\",\n      title: \"Inpatient Ward & Minimal Invasive\",\n      points: [\n        \"Penambahan IPD (Inpatient Department) di lantai 9 dengan kapasitas penambahan sejumlah 75 Bed baru.\",\n        \"Peluncuran unit bedah Laparoscopy (operasi lubang kunci) yang minim sayatan, aman, dan berpemulihan kilat.\"\n      ],\n      tagline: \"Fase Implementasi Operasional Tingkat Tinggi\"\n    },\n    {\n      year: \"2027\",\n      id: \"p2027\",\n      title: \"Cath Lab, IPD Expansion, & Chemotherapy\",\n      points: [\n        \"Instalasi Cath Lab (Catheterization Laboratory) mutakhir untuk penanganan jantung koroner mendesak.\",\n        \"Penambahan Bed IPD tambahan di lantai 8 berkapasitas 100 Bed.\",\n        \"Pembukaan Unit Kemoterapi terdedikasi untuk penderita kanker kronis di Ambon secara komprehensif.\"\n      ],\n      tagline: \"Fase Kematangan Layanan Sub-Spesialistik Jantung & Kanker\"\n    },\n    {\n      year: \"2028\",\n      id: \"p2028\",\n      title: \"Advanced Diagnostis Imaging (MRI)\",\n      points: [\n        \"Aktivasi Unit MRI (Magnetic Resonance Imaging) berspesifikasi medan magnet tinggi untuk pelacakan jaringan lunak secara ekstrem akurat tanpa radiasi X-ray.\",\n        \"Integrasi telehealth menyeluruh berbasis Cloud untuk rujukan instan ke seluruh jaringan besar Siloam Hospitals.\"\n      ],\n      tagline: \"Fase Digitalisasi & Diagnostik Visual Teratas\"\n    }\n  ];\n\n  return (\n    <div className=\"relative w-full h-full bg-[#f8faff] text-slate-800 p-8 flex flex-col justify-between overflow-hidden\">\n      \n      {/* Wave lines background */}\n      <div className=\"absolute inset-x-0 bottom-0 h-1/3 bg-slate-100/50 -skew-y-3 pointer-events-none border-t border-slate-150/40\" />\n\n      {/* Header */}\n      <div className=\"flex justify-between items-center z-10\">\n        <div>\n          <span className=\"text-2xl font-bold text-[#003399]\">RSU Siloam</span>\n          <span className=\"text-xs ml-3 text-slate-400 font-mono font-semibold\">Siloam Hospitals Ambon</span>\n        </div>\n        <div>\n          <span className=\"text-xs font-bold text-[#b0841a] tracking-widest bg-amber-50 px-3 py-1 rounded-full border border-amber-150/20\">\n            BUSINESS STRATEGY ROADMAP\n          </span>\n        </div>\n      </div>\n\n      {/* Title */}\n      <div className=\"mt-4 z-10\">\n        <h2 className=\"text-5xl font-black text-[#003399] tracking-tight flex items-center\">\n          <CalendarRange className=\"w-8 h-8 mr-3 text-amber-500\" />\n          Four Years Plan\n        </h2>\n        <p className=\"text-xs text-slate-400 font-mono mt-1 font-semibold uppercase\">\n          STRATEGI PENGEMBANGAN TERPADU RSU SILOAM AMBON (2025 - 2028)\n        </p>\n      </div>\n\n      {/* Interactive Timeline Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 my-auto z-10 items-stretch py-4\">\n        \n        {/* Left column: Quick Year Picker timeline buttons */}\n        <div className=\"lg:col-span-5 flex flex-col justify-center space-y-3\">\n          {plans.map((p, idx) => (\n            <button\n              key={p.year}\n              onClick={() => setActivePlanIdx(idx)}\n              className={`w-full text-left p-4 rounded-xl border flex items-center justify-between transition-all select-none ${\n                activePlanIdx === idx\n                  ? \"bg-white text-slate-800 shadow-xl border-[#003399]/30 scale-[1.01]\"\n                  : \"bg-slate-50 border-slate-100 text-slate-500 hover:bg-slate-100\"\n              }`}\n            >\n              <div className=\"flex items-center space-x-4\">\n                <span className={`text-2xl font-black font-mono px-3 py-1 rounded-lg ${\n                  activePlanIdx === idx ? \'bg-[#002f8a] text-white\' : \'bg-slate-200 text-slate-600\'\n                }`}>\n                  {p.year}\n                </span>\n                <div>\n                  <h4 className=\"text-xs font-extrabold uppercase tracking-wide\">\n                    {p.tagline}\n                  </h4>\n                  <p className=\"text-[10px] text-slate-400\">At Siloam Hospitals Ambon</p>\n                </div>\n              </div>\n              <ArrowRight className={`w-4 h-4 transition-transform ${activePlanIdx === idx ? \'text-amber-500 translate-x-1\' : \'text-slate-300\'}`} />\n            </button>\n          ))}\n        </div>\n\n        {/* Right column: Active plan details block */}\n        <div className=\"lg:col-span-7 bg-white rounded-2xl p-6 border border-slate-100 shadow-2xl shadow-slate-100/50 flex flex-col justify-between relative overflow-hidden\">\n          <div className=\"absolute right-0 top-0 h-24 w-24 bg-gradient-to-br from-[#003399]/5 to-transparent rounded-full filter blur-xl\" />\n\n          <div>\n            <div className=\"flex justify-between items-center mb-4 border-b border-slate-50 pb-3\">\n              <span className=\"text-xs font-extrabold uppercase tracking-wider text-[#b0841a] bg-amber-50 px-3 py-1 rounded-full border border-amber-100/30\">\n         