  file_change {
    absolute_path_uri: "file:///src/components/SlideEquipments.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { motion } from \"motion/react\";\nimport { Zap, Activity, ShieldAlert, Cpu, HeartPulse, Settings } from \"lucide-react\";\nimport { HospitalFacility } from \"../types\";\n\ninterface SlideEquipmentsProps {\n  page: 1 | 2 | 3; // page 1 -> ppt page 10 (ESWL, PCNL), page 2 -> ppt page 11 (C-Arm, CT SCAN), page 3 -> ppt page 12 (Phaco, Surgery Microscope)\n  facilities: HospitalFacility[];\n}\n\nexport function SlideEquipments({ page, facilities }: SlideEquipmentsProps) {\n  const getPageContext = () => {\n    switch (page) {\n      case 1: // ESWL & PCNL\n        return {\n          subtitle: \"ADVANCED UROLOGY TREATMENT\",\n          items: facilities.filter(f => f.id === \"facility-eswl\" || f.id === \"facility-pcnl\"),\n        };\n      case 2: // C-Arm & CT Scan\n        return {\n          subtitle: \"DIAGNOSTIC & SURGICAL IMAGING\",\n          items: facilities.filter(f => f.id === \"facility-carm\" || f.id === \"facility-ctscan\"),\n        };\n      case 3: // Phaco & Surgery Microscope\n        return {\n          subtitle: \"MICROSURGICAL OPHTHALMOLOGY\",\n          items: facilities.filter(f => f.id === \"facility-phaco\" || f.id === \"facility-surgery-microscope\"),\n        };\n    }\n  };\n\n  const { subtitle, items } = getPageContext();\n\n  // Get nice tech icons for the machines\n  const getTechIcon = (id: string) => {\n    switch (id) {\n      case \"facility-eswl\":\n        return <Zap className=\"w-6 h-6 text-amber-500\" />;\n      case \"facility-pcnl\":\n        return <Activity className=\"w-6 h-6 text-sky-500\" />;\n      case \"facility-carm\":\n        return <Cpu className=\"w-6 h-6 text-[#10b981]\" />;\n      case \"facility-ctscan\":\n        return <HeartPulse className=\"w-6 h-6 text-indigo-500\" />;\n      case \"facility-phaco\":\n        return <Settings className=\"w-6 h-6 text-[#002f8a]\" />;\n      case \"facility-surgery-microscope\":\n        return <Activity className=\"w-6 h-6 text-pink-500\" />;\n      default:\n        return <Cpu className=\"w-6 h-6 text-[#003399]\" />;\n    }\n  };\n\n  const getAccentGradient = (id: string) => {\n    switch (id) {\n      case \"facility-eswl\":\n        return \"from-amber-500/10 to-transparent border-amber-500/20\";\n      case \"facility-pcnl\":\n        return \"from-sky-500/10 to-transparent border-sky-500/20\";\n      case \"facility-carm\":\n        return \"from-emerald-500/10 to-transparent border-emerald-500/20\";\n      case \"facility-ctscan\":\n        return \"from-indigo-500/10 to-transparent border-indigo-500/20\";\n      default:\n        return \"from-blue-500/10 to-transparent border-blue-500/20\";\n    }\n  };\n\n  return (\n    <div className=\"relative w-full h-full bg-[#fcfdfe] text-slate-800 p-8 flex flex-col justify-between overflow-hidden\">\n      \n      {/* Dynamic tech net backdrop */}\n      <div className=\"absolute right-0 top-0 bottom-0 w-1/3 bg-[#003399]/[0.01] pointer-events-none z-0 border-l border-slate-100\" />\n\n      {/* Slide Header */}\n      <div className=\"flex justify-between items-center z-10\">\n        <div>\n          <span className=\"text-2xl font-bold text-[#003399]\">RSU Siloam</span>\n          <span className=\"text-xs ml-3 text-slate-400 font-mono\">Siloam Hospitals Ambon</span>\n        </div>\n        <div className=\"text-right\">\n          <span className=\"text-xs font-bold text-[#b0841a] tracking-widest uppercase\">\n            {subtitle}\n          </span>\n        </div>\n      </div>\n\n      {/* Title */}\n      <div className=\"mt-4 mb-4 z-10\">\n        <h2 className=\"text-4xl font-extrabold text-[#003399] tracking-tight\">\n          Our Facilities\n        </h2>\n        <p className=\"text-xs text-slate-400 font-mono uppercase mt-1\">\n          PERALATAN MEDIS CANGGIH & REVOLUSIONER\n        </p>\n      </div>\n\n      {/* Main Grid: Shows 2 columns for the 2 items matching page */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 my-auto z-10 items-stretch py-4\">\n        {items.map((machine, index) => (\n          <motion.div\n            key={machine.id}\n            initial={{ opacity: 0, scale: 0.98, x: index === 0 ? -15 : 15 }}\n            animate={{ opacity: 1, scale: 1, x: 0 }}\n            transition={{ duration: 0.5, ease: \"easeOut\" }}\n            whileHover={{ y: -4 }}\n            className={`bg-white border select-none rounded-2xl p-6 shadow-xl shadow-slate-100/50 flex flex-col justify-between transition-all relative overflow-hidden group border-slate-150`}\n          >\n            {/* Ambient accent background corners */}\n            <div className={`absolute -right-12 -top-12 w-32 h-32 rounded-full pointer-events-none filter blur-2xl opacity-40 bg-gradient-to-br ${getAccentGradient(machine.id)}`} />\n\n            <div>\n              <div className=\"flex justify-between items-center mb-4\">\n                <div className=\"p-2.5 bg-slate-50 border border-slate-100 rounded-xl group-hover:scale-105 transition-transform\">\n                  {getTechIcon(machine.id)}\n                </div>\n                <div className=\"text-[9px] font-bold text-[#b0841a] uppercase bg-amber-50 rounded-full px-2.5 py-1 tracking-wider border border-amber-100/20\">\n                  HIGH-TECH EQUIP\n                </div>\n              </div>\n\n              <h3 className=\"text-2xl font-black text-[#002f8a] tracking-tight mb-3\">\n                {machine.title}\n              </h3>\n              <p className=\"text-xs text-slate-500 leading-relaxed mb-6\">\n                {machine.description}\n              </p>\n            </div>\n\n            {/* Spec tags */}\n            {machine.specs && (\n              <div className=\"border-t border-slate-50 pt-4 mt-auto\">\n                <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-2 font-mono\">\n                  HIGHLIGHT KEUNGGULAN ALAT:\n                </span>\n                <div className=\"flex flex-col space-y-2\">\n                  {machine.specs.map((spec, i) => (\n                    <div key={i} className=\"flex items-center space-x-2\">\n                      <div className=\"w-1.5 h-1.5 bg-[#b0841a] rounded-full shrink-0\" />\n                      <span className=\"text-xs text-slate-700 font-sans\">{spec}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n          </motion.div>\n        ))}\n      </div>\n\n      {/* Footer */}\n      <div className=\"flex justify-between items-center text-slate-400 text-xs\">\n        <span>#BersamaSiloam</span>\n        <span className=\"font-mono\">Page {9 + page} / 45</span>\n      </div>\n    </div>\n  );\n}\n"
    }
