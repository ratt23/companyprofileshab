    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \"react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { Doctor, YearStats, HospitalFacility, DatabaseState } from \"./types\";\nimport { SlideCover } from \"./components/SlideCover\";\nimport { SlideExcelence } from \"./components/SlideExcelence\";\nimport { SlideStats } from \"./components/SlideStats\";\nimport { SlideFacilities } from \"./components/SlideFacilities\";\nimport { SlideClinic } from \"./components/SlideClinic\";\nimport { SlideEquipments } from \"./components/SlideEquipments\";\nimport { SlidePlan } from \"./components/SlidePlan\";\nimport { SlideDoctors } from \"./components/SlideDoctors\";\nimport { SlideSocialMedia } from \"./components/SlideSocialMedia\";\nimport { RosterView } from \"./components/RosterView\";\nimport { AdminPanel } from \"./components/AdminPanel\";\nimport { defaultDatabaseState } from \"./default_data_payload\";\nimport {\n  ChevronLeft,\n  ChevronRight,\n  Play,\n  Pause,\n  Maximize2,\n  Minimize2,\n  Database,\n  Search,\n  Settings,\n  Tv,\n  Users,\n  Info,\n  CalendarDays,\n  RefreshCw\n} from \"lucide-react\";\n\nexport default function App() {\n  const [dbState, setDbState] = useState<DatabaseState>(defaultDatabaseState);\n  const [currentSlideIndex, setCurrentSlideIndex] = useState(0);\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [isFullscreen, setIsFullscreen] = useState(false);\n  const [loading, setLoading] = useState(true);\n\n  // Modular panels\n  const [showRoster, setShowRoster] = useState(false);\n  const [showAdmin, setShowAdmin] = useState(false);\n\n  const containerRef = useRef<HTMLDivElement>(null);\n  const autoPlayTimerRef = useRef<NodeJS.Timeout | null>(null);\n\n  // Fetch live database statistics and doctor schedules on boot\n  useEffect(() => {\n    async function loadDatabase() {\n      try {\n        const response = await fetch(\"/api/data\");\n        if (response.ok) {\n          const data = await response.json();\n          if (data && data.doctors && data.stats) {\n            setDbState(data);\n          }\n        }\n      } catch (err) {\n        console.warn(\"Could not connect to live API, using offline default state:\", err);\n      } finally {\n        setLoading(false);\n      }\n    }\n    loadDatabase();\n  }, []);\n\n  // Sync state mutations persistently to Express file database\n  const handleUpdateDatabase = async (newDoctors: Doctor[], newStats: YearStats[]) => {\n    const updatedState = {\n      ...dbState,\n      doctors: newDoctors,\n      stats: newStats\n    };\n    setDbState(updatedState);\n\n    try {\n      const response = await fetch(\"/api/data\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\"\n        },\n        body: JSON.stringify(updatedState)\n      });\n      if (!response.ok) {\n        throw new Error(\"Failed to write state on Express backend\");\n      }\n    } catch (err) {\n      console.error(\"Persistence save failure:\", err);\n    }\n  };\n\n  // Keyboard Navigation: support Space/Right/Down for Next, Left/Up for Prev\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      // Guard: do not capture triggers if modifying text fields in modals\n      const target = e.target as HTMLElement;\n      if (\n        target.tagName === \"INPUT\" ||\n        target.tagName === \"SELECT\" ||\n        target.tagName === \"TEXTAREA\" ||\n        showRoster ||\n        showAdmin\n      ) {\n        return;\n      }\n\n      if (e.key === \"ArrowRight\" || e.key === \" \" || e.key === \"PageDown\") {\n        e.preventDefault();\n        nextSlide();\n      } else if (e.key === \"ArrowLeft\" || e.key === \"PageUp\") {\n        e.preventDefault();\n        prevSlide();\n      } else if (e.key === \"r\" || e.key === \"R\") {\n        setShowRoster(prev => !prev);\n      } else if (e.key === \"a\" || e.key === \"A\") {\n        setShowAdmin(prev => !prev);\n      } else if (e.key === \"f\" || e.key === \"F\") {\n        toggleFullscreen();\n      }\n    };\n\n    window.addEventListener(\"keydown\", handleKeyDown);\n    return () => {\n      window.removeEventListener(\"keydown\", handleKeyDown);\n    };\n  }, [currentSlideIndex, showRoster, showAdmin]);\n\n  // Handle Autoplay Slideshow Player\n  useEffect(() => {\n    if (isPlaying) {\n      autoPlayTimerRef.current = setInterval(() => {\n        nextSlide();\n      }, 8000); // 8 seconds per slide change\n    } else {\n      if (autoPlayTimerRef.current) {\n        clearInterval(autoPlayTimerRef.current);\n      }\n    }\n\n    return () => {\n      if (autoPlayTimerRef.current) {\n        clearInterval(autoPlayTimerRef.current);\n      }\n    };\n  }, [isPlaying, currentSlideIndex]);\n\n  const nextSlide = () => {\n    setCurrentSlideIndex(prev => (prev < 44 ? prev + 1 : 0));\n  };\n\n  const prevSlide = () => {\n    setCurrentSlideIndex(prev => (prev > 0 ? prev - 1 : 44));\n  };\n\n  const toggleFullscreen = () => {\n    if (!containerRef.current) return;\n\n    if (!document.fullscreenElement) {\n      containerRef.current.requestFullscreen().then(() => {\n        setIsFullscreen(true);\n      }).catch(err => {\n        console.error(\"Error enabling fullscreen mode:\", err);\n      });\n    } else {\n      document.exitFullscreen();\n      setIsFullscreen(false);\n    }\n  };\n\n  // Monitor browser exit-fullscreen triggers\n  useEffect(() => {\n    const handleFullscreenChange = () => {\n      setIsFullscreen(!!document.fullscreenElement);\n    };\n    document.addEventListener(\"fullscreenchange\", handleFullscreenChange);\n    return () => {\n      document.removeEventListener(\"fullscreenchange\", handleFullscreenChange);\n    };\n  }, []);\n\n  const slideCatalog = [\n    { id: 0, label: \"1. Cover Slide - Sambutan RSU Siloam\" },\n    { id: 1, label: \"2. Center of Excellence (Layanan Unggulan)\" },\n    { id: 2, label: \"3. Tren Statistik Kunjungan Pasien (Recharts)\" },\n    { id: 3, label: \"4. Layanan: IGD 24 Jam & Siloam at Home\" },\n    { id: 4, label: \"5. Layanan: Radiologi & Rawat Jalan\" },\n    { id: 5, label: \"6. Layanan: Rawat Inap & Ambulans Rescue\" },\n    { id: 6, label: \"7. Bangsal Terintegrasi: Kamar VVIP, VIP, Kelas I\" },\n    { id: 7, label: \"8. Bangsal Terintegrasi: Kamar Kelas II & Kelas III\" },\n    { id: 8, label: \"9. Executive Clinic: Lobby Premium & Lounge\" },\n    { id: 9, label: \"10. Alat Tinggi: ESWL & PCNL Urologi\" },\n    { id: 10, label: \"11. Alat Tinggi: C-Arm & CT Scan Diagnostik\" },\n    { id: 11, label: \"12. Alat Tinggi: Bedah Phaco & Mikroskop Bedah\" },\n    { id: 12, label: \"13. Future Plan: Rencana Kerja Jangka Panjang\" },\n    \n    // Doctor Specialty slideshow mapping to slides indices 13 to 43 (Page 14 to 44)\n    { id: 13, label: \"14. Dokter: Spesialis THT (Otolaryngologist)\" },\n    { id: 14, label: \"15. Dokter: Spesialis Paru (Pulmonologist)\" },\n    { id: 15, label: \"16. Dokter: Kebidanan & Kandungan I (Obgyn)\" },\n    { id: 16, label: \"17. Dokter: Kebidanan & Kandungan II (Obgyn)\" },\n    { id: 17, label: \"18. Dokter: Spesialis Anak (Pediatrician)\" },\n    { id: 18, label: \"19. Dokter: Spesialis Bedah Umum (General Surgeon)\" },\n    { id: 19, label: \"20. Dokter: Spesialis Bedah Urologi (Urology)\" },\n    { id: 20, label: \"21. Jantung & Bedah Vaskular (Cardiothoracic)\" },\n    { id: 21, label: \"22. Dokter: Spesialis Saraf (Neurologist)\" },\n    { id: 22, label: \"23. Dokter: Penyakit Dalam I (Internist)\" },\n    { id: 23, label: \"24. Dokter: Penyakit Dalam II (Internist)\" },\n    { id: 24, label: \"25. Dokter: Gigi Umum (Dentist)\" },\n    { id: 25, label: \"26. Dokter: Gigi Spesialis Prostodonsia\" },\n    { id: 26, label: \"27. Dokter: Gigi Spesialis Penyakit Mulut\" },\n    { id: 27, label: \"28. Dokter: Gigi Spesialis Pedodonti (Anak)\" },\n    { id: 28, label: \"29. Dokter: Gigi Spesialis Bedah Mulut\" },\n    { id: 29, label: \"30. Dokter: Gigi Spesialis Endodonti\" },\n    { id: 30, label: \"31. Dokter: Spesialis Mata (Ophthalmologist)\" },\n    { id: 31, label: \"32. Dokter: Spesialis Jantung (Cardiologist)\" },\n    { id: 32, label: \"33. Dokter: Kulit & Kelamin (Dermatologist)\" },\n    { id: 33, label: \"34. Kedokteran Fisik & Rehabilitasi (Physiatry)\" },\n    { id: 34, label: \"35. Dokter: Spesialis Gizi Klinik (Clinical Nutrition)\" },\n    { id: 35, label: \"36. Dokter: Spesialis Jiwa / Psikiater (Psychiatrist)\" },\n    { id: 36, label: \"37. Bedah Onkologi / Kanker (Surgical Oncology)\" },\n    { id: 37, label: \"38. Bedah Orthopedi Hip & Knee (Sendi)\" },\n    { id: 38, label: \"39. Orthopedi Sport Injury (Cedera Olahraga)\" },\n    { id: 39, label: \"40. Internist: Spesialis Ginjal & Hipertensi\" },\n    { id: 40, label: \"41. Kandungan Subspesialis Bedah Onkologi I\" },\n    { id: 41, label: \"42. Kandungan Subspesialis Bedah Onkologi II\" },\n    { id: 42, label: \"43. Kandungan Subspesialis Fetomaternal\" },\n    { id: 43, label: \"44. Dokter: Spesialis Anestesi (Anaesthesiologist)\" },\n    \n    { id: 44, label: \"45. Connect: Media Sosial RSU Siloam Ambon\" }\n  ];\n\n  // Helper to render the active slide component matching index\n  const renderSlideContent = () => {\n    const idx = currentSlideIndex;\n\n    if (idx === 0) return <SlideCover />;\n    if (idx === 1) return <SlideExcelence />;\n    if (idx === 2) return <SlideStats stats={dbState.stats} />;\n    \n    // Facilities (pages 1 to 5) indices 3 to 7\n    if (idx >= 3 && idx <= 7) {\n      const pageIndex = (idx - 2) as 1 | 2 | 3 | 4 | 5;\n      return <SlideFacilities page={pageIndex} facilities={dbState.facilities} />;\n    }\n    \n    if (idx === 8) return <SlideClinic />;\n\n    // Machinery/Equipment indices 9 to 11\n    if (idx >= 9 && idx <= 11) {\n      const equipPage = (idx - 8) as 1 | 2 | 3;\n      return <SlideEquipments page={equipPage} facilities={dbState.facilities} />;\n    }\n\n    if (idx === 12) return <SlidePlan />;\n\n    // Doctor Specialties slides mapping internally 13 to 43 -> offset 0 to 30\n    if (idx >= 13 && idx <= 43) {\n      const doctorOffset = idx - 13;\n      return <SlideDoctors offset={doctorOffset} doctors={dbState.doctors} />;\n    }\n\n    if (idx === 44) return <SlideSocialMedia />;\n\n    return <SlideCover />;\n  };\n\n  return (\n    <div className=\"w-screen h-screen flex flex-col items-center justify-between bg-slate-950 font-sans text-white select-none relative overflow-hidden\">\n      \n      {/* Background ambient lighting */}\n      <div className=\"absolute top-0 left-0 w-96 h-96 bg-[#003399]/10 rounded-full filter blur-3xl pointer-events-none\" />\n      <div className=\"absolute bottom-0 right-0 w-96 h-96 bg-[#b0841a]/5 rounded-full filter blur-3xl pointer-events-none\" />\n\n      {/* Primary Top Action Bar */}\n      <header className=\"w-full bg-slate-900/40 backdrop-blur-md border-b border-slate-800/50 px-6 py-3 shrink-0 flex justify-between items-center z-30\">\n        <div className=\"flex items-center space-x-3\">\n          <Tv className=\"w-5 h-5 text-amber-500\" />\n          <div>\n            <span className=\"font-extrabold text-sm tracking-tight text-white\">\n              RSU Siloam Ambon\n            </span>\n            <span className=\"text-[10px] ml-2 font-mono text-emerald-400 bg-emerald-950 px-2 py-0.5 rounded border border-emerald-900/30\">\n              \342\227\217 LIVE PRESENTER ACTIVE\n            </span>\n          </div>\n        </div>\n\n        {/* Presenter Database Query Tools & Locks */}\n        <div className=\"flex items-center space-x-2\">\n          \n          <button\n            onClick={() => setShowRoster(true)}\n            className=\"px-3.5 py-1.5 bg-slate-800 hover:bg-[#003399] rounded-xl text-xs font-bold leading-none flex items-center space-x-1.5 transition-all text-slate-200 border border-slate-700/50 shadow\"\n          >\n            <Users className=\"w-3.5 h-3.5 text-amber-500\" />\n            <span>Cari Roster Dokter ({dbState.doctors.length})</span>\n          </button>\n\n          <button\n            onClick={() => setShowAdmin(true)}\n            className=\"px-3.5 py-1.5 bg-slate-800 hover:bg-[#b0841a] rounded-xl text-xs font-bold leading-none flex items-center space-x-1.5 transition-all text-slate-200 border border-slate-700/50 shadow\"\n          >\n            <Settings className=\"w-3.5 h-3.5 text-sky-400 animate-spin-slow\" />\n            <span>Kelola Database</span>\n          </button>\n\n        </div>\n      </header>\n\n      {/* Main Slide Deck Canvas - Styled as dynamic PowerPoint widescreen screen */}\n      <main className=\"flex-grow w-full flex items-center justify-center p-4\">\n        {loading ? (\n          <div className=\"text-center space-y-3\">\n            <RefreshCw className=\"w-10 h-10 animate-spin text-amber-500 mx-auto\" />\n            <p className=\"text-slate-400 text-xs font-mono\">Menyiapkan Database Slide RSU Siloam...</p>\n          </div>\n        ) : (\n          <div\n            ref={containerRef}\n            className=\"w-full max-w-5xl aspect-[16/9] bg-white rounded-3xl shadow-2xl shadow-blue-900/30 overflow-hidden relative border border-slate-800/10 flex flex-col justify-between\"\n          >\n            {/* Elegant slider screen with transition */}\n            <AnimatePresence mode=\"wait\">\n              <motion.div\n                key={currentSlideIndex}\n                initial={{ opacity: 0, x: 20 }}\n                animate={{ opacity: 1, x: 0 }}\n                exit={{ opacity: 0, x: -20 }}\n                transition={{ duration: 0.35, ease: \"easeInOut\" }}\n                className=\"w-full h-full\"\n              >\n                {renderSlideContent()}\n              </motion.div>\n            </AnimatePresence>\n          </div>\n        )}\n      </main>\n\n      {/* Slider deck controls footer navigation bar */}\n      <footer className=\"w-full bg-slate-900/60 backdrop-blur-md border-t border-slate-800/50 px-6 py-4 shrink-0 flex flex-col md:flex-row justify-between items-center z-30 space-y-3 md:space-y-0 text-xs\">\n        \n        {/* Custom Slide Catalog picker menu list */}\n        <div className=\"flex items-center space-x-2.5 w-full md:w-auto\">\n          <span className=\"text-slate-500 font-extrabold uppercase text-[10px] tracking-widest font-mono\">Slide:</span>\n          <select\n            value={currentSlideIndex}\n            onChange={(e) => setCurrentSlideIndex(parseInt(e.target.value))}\n            className=\"bg-slate-800 border border-slate-700 text-xs font-bold rounded-xl px-3 py-1.5 text-slate-200 outline-none w-full md:w-64\"\n          >\n            {slideCatalog.map(slide => (\n              <option key={slide.id} value={slide.id}>\n                {slide.label}\n              </option>\n            ))}\n          </select>\n        </div>\n\n        {/* Presenter controls panel */}\n        <div className=\"flex items-center space-x-4\">\n          <div className=\"flex bg-slate-800 rounded-xl p-1 border border-slate-700/50\">\n            <button\n              onClick={prevSlide}\n              title=\"Prev Slide (Left Arrow)\"\n              className=\"p-1.5 hover:bg-slate-700 rounded-lg text-slate-300 transition-colors\"\n            >\n              <ChevronLeft className=\"w-4 h-4\" />\n            </button>\n\n            <button\n              onClick={() => setIsPlaying(!isPlaying)}\n              title={isPlaying ? \"Pause Slideshow Auto-play\" : \"Play Autoplay Loop\"}\n              className={`px-3 py-1 rounded-lg text-xs font-bold transition-all flex items-center space-x-1.5 ${\n                isPlaying ? \"bg-amber-600 text-white\" : \"hover:bg-slate-700 text-slate-300\"\n              }`}\n            >\n              {isPlaying ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n              <span>{isPlaying ? \"Autoplay ON (8s)\" : \"Play Auto\"}</span>\n            </button>\n\n            <button\n              onClick={nextSlide}\n              title=\"Next Slide (Right Arrow / Space)\"\n              className=\"p-1.5 hover:bg-slate-700 rounded-lg text-slate-300 transition-colors\"\n            >\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          <button\n            onClick={toggleFullscreen}\n            title=\"Toggle fullscreen deck (F)\"\n            className=\"p-2 bg-slate-800 border border-slate-705/10 rounded-xl hover:bg-slate-700 transition-all text-slate-300 hover:text-white\"\n          >\n            {isFullscreen ? <Minimize2 className=\"w-4 h-4\" /> : <Maximize2 className=\"w-4 h-4\" />}\n          </button>\n        </div>\n\n        {/* Dynamic slides paging statistics */}\n        <div className=\"text-slate-500 font-mono font-bold text-[10px] tracking-wider\">\n          SLIDES DECK PAGING: <span className=\"text-slate-300\">{currentSlideIndex + 1}</span> / 45\n        </div>\n\n      </footer>\n\n      {/* Floating Database Search Roster Overlay */}\n      {showRoster && (\n        <RosterView\n          doctors={dbState.doctors}\n          onClose={() => setShowRoster(false)}\n        />\n      )}\n\n      {/* Admin Panel Overlay */}\n      {showAdmin && (\n        <AdminPanel\n          doctors={dbState.doctors}\n          stats={dbState.stats}\n          onUpdateData={handleUpdateDatabase}\n          onClose={() => setShowAdmin(false)}\n        />\n      )}\n\n    </div>\n  );\n}\n"
    }
