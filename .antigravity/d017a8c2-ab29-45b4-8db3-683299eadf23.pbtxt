  file_change {
    absolute_path_uri: "file:///src/components/SlideFacilities.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { motion } from \"motion/react\";\nimport { ShieldAlert, Home, Activity, CheckSquare, Stethoscope, Briefcase, Sparkles, Star, Award, HeartHandshake } from \"lucide-react\";\nimport { HospitalFacility } from \"../types\";\n\ninterface SlideFacilitiesProps {\n  page: 1 | 2 | 3 | 4 | 5; // Corresponding to Pages 4, 5, 6, 7, 8\n  facilities: HospitalFacility[];\n}\n\nexport function SlideFacilities({ page, facilities }: SlideFacilitiesProps) {\n  // Let\'s filter the facilities list that matches this specific page view\n  const getPageData = () => {\n    switch (page) {\n      case 1: // Page 4: Emergency, Siloam at Home\n        return {\n          title: \"Our Facilities\",\n          subtitle: \"EMERGENCY & COMMUNITY SERVICES\",\n          items: facilities.filter(f => f.id === \"facility-emergency\" || f.id === \"facility-siloam-home\"),\n          colClass: \"grid-cols-1 md:grid-cols-2\",\n        };\n      case 2: // Page 5: Radiology, Outpatient\n        return {\n          title: \"Our Facilities\",\n          subtitle: \"DIAGNOSTIC & SPECIALIST OUTPATIENT\",\n          items: facilities.filter(f => f.id === \"facility-radiology\" || f.id === \"facility-outpatient\"),\n          colClass: \"grid-cols-1 md:grid-cols-2\",\n        };\n      case 3: // Page 6: Inpatient, Ambulance\n        return {\n          title: \"Our Facilities\",\n          subtitle: \"PRIMARY RESCUE & GENERAL INPATIENT\",\n          items: facilities.filter(f => f.id === \"facility-inpatient\" || f.id === \"facility-ambulance\"),\n          colClass: \"grid-cols-1 md:grid-cols-2\",\n        };\n      case 4: // Page 7: VVIP, VIP, Kelas I\n        return {\n          title: \"Our Facilities\",\n          subtitle: \"INPATIENT WARDS - PRIVATE & PREMIUM\",\n          items: facilities.filter(f => f.id === \"facility-vvip\" || f.id === \"facility-vip\" || f.id === \"facility-kelas-1\"),\n          colClass: \"grid-cols-1 md:grid-cols-3\",\n        };\n      case 5: // Page 8: Kelas 2, Kelas 3\n        return {\n          title: \"Our Facilities\",\n          subtitle: \"INPATIENT WARDS - GENERAL\",\n          items: facilities.filter(f => f.id === \"facility-kelas-2\" || f.id === \"facility-kelas-3\"),\n          colClass: \"grid-cols-1 md:grid-cols-2\",\n        };\n    }\n  };\n\n  const { title, subtitle, items, colClass } = getPageData();\n\n  // Pick nice icons for each facility card based on its id\n  const getFacilityIcon = (id: string) => {\n    switch (id) {\n      case \"facility-emergency\":\n        return <ShieldAlert className=\"w-8 h-8 text-white\" />;\n      case \"facility-siloam-home\":\n        return <Home className=\"w-8 h-8 text-white\" />;\n      case \"facility-radiology\":\n        return <Activity className=\"w-8 h-8 text-white\" />;\n      case \"facility-outpatient\":\n        return <Stethoscope className=\"w-8 h-8 text-white\" />;\n      case \"facility-inpatient\":\n        return <HeartHandshake className=\"w-8 h-8 text-white\" />;\n      case \"facility-ambulance\":\n        return <Briefcase className=\"w-8 h-8 text-white\" />;\n      case \"facility-vvip\":\n        return <Star className=\"w-8 h-8 text-amber-500 fill-amber-500\" />;\n      case \"facility-vip\":\n        return <Star className=\"w-8 h-8 text-sky-500 fill-sky-500\" />;\n      case \"facility-kelas-1\":\n        return <Award className=\"w-8 h-8 text-slate-500\" />;\n      case \"facility-kelas-2\":\n        return <CheckSquare className=\"w-8 h-8 text-[#0a66c2]\" />;\n      case \"facility-kelas-3\":\n        return <CheckSquare className=\"w-8 h-8 text-emerald-600\" />;\n      default:\n        return <Sparkles className=\"w-8 h-8 text-white\" />;\n    }\n  };\n\n  // Select matching premium gradient/visual representation cards\n  const getCardBg = (id: string) => {\n    switch (id) {\n      case \"facility-emergency\":\n        return \"from-red-650 to-red-900 border-red-200/50 bg-red-50/20\";\n      case \"facility-siloam-home\":\n        return \"from-[#0a46a3] to-[#00205b] border-blue-200/50 bg-blue-50/20\";\n      case \"facility-radiology\":\n        return \"from-slate-700 to-slate-900 border-slate-200/50 bg-slate-50/20\";\n      case \"facility-outpatient\":\n        return \"from-sky-700 to-sky-950 border-sky-200/50 bg-sky-50/20\";\n      case \"facility-inpatient\":\n        return \"from-[#0d4ea5] to-[#002f8a] border-indigo-200/50 bg-indigo-50/20\";\n      case \"facility-ambulance\":\n        return \"from-[#0b66c2] to-[#013570] border-cyan-200/50 bg-cyan-50/20\";\n      default:\n        return \"from-white to-slate-50 border-slate-150 text-slate-800\";\n    }\n  };\n\n  const isSpecialtyCard = (id: string) => {\n    return [\n      \"facility-emergency\",\n      \"facility-siloam-home\",\n      \"facility-radiology\",\n      \"facility-outpatient\",\n      \"facility-inpatient\",\n      \"facility-ambulance\"\n    ].includes(id);\n  };\n\n  return (\n    <div className=\"relative w-full h-full bg-[#f8faff] text-slate-800 p-8 flex flex-col justify-between overflow-hidden\">\n      \n      {/* Wave background curves */}\n      <div className=\"absolute left-0 bottom-0 pointer-events-none opacity-5\">\n        <svg className=\"w-96 h-96\" viewBox=\"0 0 440 440\" fill=\"none\">\n          <circle cx=\"220\" cy=\"220\" r=\"200\" stroke=\"#003399\" strokeWidth=\"10\" />\n          <circle cx=\"220\" cy=\"220\" r=\"150\" stroke=\"#b0841a\" strokeWidth=\"5\" />\n        </svg>\n      </div>\n\n      {/* Header */}\n      <div className=\"flex justify-between items-center z-10\">\n        <div>\n          <span className=\"text-2xl font-bold text-[#003399]\">RSU Siloam</span>\n          <span className=\"text-xs ml-3 text-slate-400 font-mono\">Siloam Hospitals Ambon</span>\n        </div>\n        <div className=\"text-right\">\n          <span className=\"text-xs font-bold text-[#b0841a] tracking-widest uppercase\">\n            {subtitle}\n          </span>\n        </div>\n      </div>\n\n      {/* Title */}\n      <div className=\"mt-4 mb-4 z-10\">\n        <h2 className=\"text-4xl font-extrabold text-[#003399] tracking-tight\">\n          {title}\n        </h2>\n      </div>\n\n      {/* Action Content Box */}\n      <div className={`grid ${colClass} gap-6 my-auto z-10 items-stretch h-full py-4`}>\n        {items.map((facility, index) => {\n          const darkTextCard = !isSpecialtyCard(facility.id);\n          const cardClass = darkTextCard\n            ? \"bg-white text-slate-800 border-slate-100 shadow-xl shadow-slate-100/70\"\n            : `bg-gradient-to-br ${getCardBg(facility.id)} text-white shadow-2xl shadow-blue-900/10`;\n\n          return (\n            <motion.div\n              key={facility.id}\n              initial={{ opacity: 0, scale: 0.95, y: 20 }}\n              animate={{ opacity: 1, scale: 1, y: 0 }}\n              transition={{ delay: index * 0.1, duration: 0.4 }}\n              whileHover={{ scale: 1.02 }}\n              className={`rounded-2xl p-6 border flex flex-col justify-between transition-all relative overflow-hidden group`}\n            >\n              {/* Overlay abstract design */}\n              <div className=\"absolute -right-4 -bottom-4 w-24 h-24 bg-white/5 rounded-full pointer-events-none scale-150 group-hover:scale-175 transition-transform\" />\n\n              <div>\n                <div className=\"flex justify-between items-center mb-4\">\n                  <div className={`p-3 rounded-xl ${darkTextCard ? \'bg-[#f4f7fc]\' : \'bg-white/10\'}`}>\n                    {getFacilityIcon(facility.id)}\n                  </div>\n                  <span className={`text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${\n                    darkTextCard ? \'bg-sky-50 text-sky-700\' : \'bg-white/20 text-white\'\n                  }`}>\n                    {facility.category}\n                  </span>\n                </div>\n\n                <h3 className={`text-2xl font-black tracking-tight mb-2 ${darkTextCard ? \'text-[#002f8a]\' : \'text-white\'}`}>\n                  {facility.title}\n                </h3>\n                <p className={`text-xs leading-relaxed mb-4 ${darkTextCard ? \'text-slate-500\' : \'text-white/80\'}`}>\n                  {facility.description}\n                </p>\n              </div>\n\n              {facility.specs && (\n                <div className=\"mt-4 pt-4 border-t border-slate-150/30\">\n                  <h4 className={`text-[10px] font-bold uppercase tracking-widest mb-2 ${darkTextCard ? \'text-slate-400\' : \'text-white/60\'}`}>\n                    Fasilitas Tersedia:\n                  </h4>\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {facility.specs.map((spec, i) => (\n                      <span\n                        key={i}\n                        className={`text-[10px] px-2.5 py-1 rounded-md font-sans ${\n                          darkTextCard\n                            ? \'bg-slate-50 text-slate-705 border border-slate-100\'\n                            : \'bg-white/15 text-white border border-white/5\'\n                        }`}\n                      >\n                        {spec}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              )}\n            </motion.div>\n          );\n        })}\n      </div>\n\n      {/* Footer */}\n      <div className=\"flex justify-between items-center text-slate-400 text-xs\">\n        <span>#BersamaSiloam</span>\n        <span className=\"font-mono\">Page {3 + page} / 45</span>\n      </div>\n    </div>\n  );\n}\n"
    }
