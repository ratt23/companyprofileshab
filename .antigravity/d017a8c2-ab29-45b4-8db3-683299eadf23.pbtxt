  file_change {
    absolute_path_uri: "file:///src/components/SlideDoctors.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { motion } from \"motion/react\";\nimport { Doctor } from \"../types\";\nimport { Stethoscope, Calendar, Check, Search, ShieldCheck } from \"lucide-react\";\n\ninterface SlideDoctorsProps {\n  offset: number; // 0 to 30 matching PPT Pages 14 to 44\n  doctors: Doctor[];\n}\n\nexport function SlideDoctors({ offset, doctors }: SlideDoctorsProps) {\n  // Let\'s list the exact slides (specifications) in order\n  const specialtySlides = [\n    { title: \"OTOLARYNGOLOGIST\", filter: (d: Doctor) => d.specialty === \"OTOLARYNGOLOGIST\" },\n    { title: \"PULMONOLOGIST\", filter: (d: Doctor) => d.specialty === \"PULMONOLOGIST\" },\n    { title: \"OBSTETRICS & GYNECOLOGY\", filter: (d: Doctor) => d.specialty === \"OBSTETRICS & GYNECOLOGY\", slice: [0, 3] },\n    { title: \"OBSTETRICS & GYNECOLOGY\", filter: (d: Doctor) => d.specialty === \"OBSTETRICS & GYNECOLOGY\", slice: [3, 6] },\n    { title: \"PAEDIATRICIAN\", filter: (d: Doctor) => d.specialty === \"PAEDIATRICIAN\" },\n    { title: \"GENERAL SURGEON\", filter: (d: Doctor) => d.specialty === \"GENERAL SURGEON\" },\n    { title: \"UROLOGY\", filter: (d: Doctor) => d.specialty === \"UROLOGY\" },\n    { title: \"CARDIOTHORACIC & VASCULAR SURGERY\", filter: (d: Doctor) => d.specialty === \"CARDIOTHORACIC & VASCULAR SURGERY\" },\n    { title: \"NEUROLOGIST\", filter: (d: Doctor) => d.specialty === \"NEUROLOGIST\" },\n    { title: \"INTERNIST\", filter: (d: Doctor) => d.specialty === \"INTERNIST\", slice: [0, 3] },\n    { title: \"INTERNIST\", filter: (d: Doctor) => d.specialty === \"INTERNIST\", slice: [3, 6] },\n    { title: \"DENTIST\", filter: (d: Doctor) => d.specialty === \"DENTIST\" },\n    { title: \"PROSTHODONTIST\", filter: (d: Doctor) => d.specialty === \"PROSTHODONTIST\" },\n    { title: \"ORAL MEDICINE\", filter: (d: Doctor) => d.specialty === \"ORAL MEDICINE\" },\n    { title: \"PEDODONTIST\", filter: (d: Doctor) => d.specialty === \"PEDODONTIST\" },\n    { title: \"ORAL SURGEON\", filter: (d: Doctor) => d.specialty === \"ORAL SURGEON\" },\n    { title: \"ENDODONTIST\", filter: (d: Doctor) => d.specialty === \"ENDODONTIST\" },\n    { title: \"OPHTHALMOLOGIST\", filter: (d: Doctor) => d.specialty === \"OPHTHALMOLOGIST\" },\n    { title: \"CARDIOLOGIST\", filter: (d: Doctor) => d.specialty === \"CARDIOLOGIST\" },\n    { title: \"DERMATOLOGIST\", filter: (d: Doctor) => d.specialty === \"DERMATOLOGIST\" },\n    { title: \"PHYSICAL MEDICINE & REHABILITATION SPECIALIST\", filter: (d: Doctor) => d.specialty === \"PHYSICAL MEDICINE & REHABILITATION SPECIALIST\" },\n    { title: \"CLINICAL NUTRITION\", filter: (d: Doctor) => d.specialty === \"CLINICAL NUTRITION\" },\n    { title: \"PSYCHIATRIST\", filter: (d: Doctor) => d.specialty === \"PSYCHIATRIST\" },\n    { title: \"SURGICAL ONCOLOGY\", filter: (d: Doctor) => d.specialty === \"SURGICAL ONCOLOGY\" },\n    { title: \"ORTHOPEDIC HIP&KNEE\", filter: (d: Doctor) => d.specialty === \"ORTHOPEDIC HIP&KNEE\" },\n    { title: \"ORTHOPEDIC SPORT INJURY\", filter: (d: Doctor) => d.specialty === \"ORTHOPEDIC SPORT INJURY\" },\n    { title: \"INTERNIST \342\200\223 KIDNEY & HYPERTENSION SPECIALIST\", filter: (d: Doctor) => d.specialty === \"INTERNIST \342\200\223 KIDNEY & HYPERTENSION SPECIALIST\" },\n    { title: \"OBSTETRICS AND GYNECOLOGY ONCOLOGY\", filter: (d: Doctor) => d.specialty === \"OBSTETRICS AND GYNECOLOGY ONCOLOGY\", slice: [0, 1] },\n    { title: \"OBSTETRICS AND GYNECOLOGY ONCOLOGY\", filter: (d: Doctor) => d.specialty === \"OBSTETRICS AND GYNECOLOGY ONCOLOGY\", slice: [1, 2] },\n    { title: \"OBSTETRICS AND GYNECOLOGY MATERNAL\342\200\223FETAL MEDICINE\", filter: (d: Doctor) => d.specialty === \"OBSTETRICS AND GYNECOLOGY MATERNAL\342\200\223FETAL MEDICINE\" },\n    { title: \"ANAESTHETIC\", filter: (d: Doctor) => d.specialty === \"ANAESTHETIC\" }\n  ];\n\n  const currentSlide = specialtySlides[offset] || specialtySlides[0];\n  let filteredList = doctors.filter(currentSlide.filter);\n\n  // If there is slice defined, let\'s slice it\n  if (currentSlide.slice) {\n    filteredList = filteredList.slice(currentSlide.slice[0], currentSlide.slice[1]);\n  }\n\n  // Helper to extract clean doctor initials for professional placeholder avatar\n  const getInitials = (name: string) => {\n    let clean = name.replace(/^(Dr\\.|dr\\.|drg\\.)\\s*/i, \"\").trim();\n    clean = clean.split(\",\")[0].trim(); // Remove suffixes like Sp.THT\n    const parts = clean.split(\" \");\n    if (parts.length >= 2) {\n      return (parts[0][0] + parts[1][0]).toUpperCase();\n    }\n    return parts[0] ? parts[0][0].toUpperCase() : \"DR\";\n  };\n\n  // List of gradient color options for doctor backgrounds to look super gorgeous\n  const avatarColors = [\n    \"from-slate-700 to-slate-900 shadow-slate-900/10 text-white\",\n    \"from-indigo-900 to-[#0e4ca2] shadow-blue-900/10 text-white\",\n    \"from-[#002f8a] to-[#0a66c2] shadow-indigo-900/10 text-white\"\n  ];\n\n  return (\n    <div className=\"relative w-full h-full bg-white text-slate-800 p-8 flex flex-col justify-between overflow-hidden\">\n      \n      {/* Wave Background Pattern */}\n      <div className=\"absolute right-0 top-0 bottom-0 w-1/5 bg-slate-50 pointer-events-none -skew-x-6 border-l border-slate-100/50 hidden md:block\" />\n\n      {/* Header */}\n      <div className=\"flex justify-between items-center z-10\">\n        <div>\n          <span className=\"text-2xl font-bold text-[#003399]\">RSU Siloam</span>\n          <span className=\"text-xs ml-3 text-slate-400 font-mono\">Siloam Hospitals Ambon</span>\n        </div>\n        <div className=\"text-right\">\n          <span className=\"text-xs font-mono font-bold text-[#b0841a] uppercase bg-amber-50 rounded-full px-3 py-1 border border-amber-100/30\">\n            DOKTER SPESIALIS KAMI\n          </span>\n        </div>\n      </div>\n\n      {/* Slide Body Layout */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 my-auto z-10 items-center py-4\">\n        \n        {/* Left Column: Big Banner with Specialty title */}\n        <div className=\"lg:col-span-4 flex flex-col justify-center border-l-4 border-[#003399] pl-6 py-2\">\n          <motion.h4\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            className=\"text-xs uppercase font-extrabold tracking-widest text-[#b0841a] mb-1\"\n          >\n            OUR DOCTOR\n          </motion.h4>\n          <motion.h2\n            key={currentSlide.title}\n            initial={{ opacity: 0, x: -15 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.4 }}\n            className=\"text-4xl md:text-5xl font-black text-[#003399] tracking-tight leading-none\"\n          >\n            {currentSlide.title}\n          </motion.h2>\n          <p className=\"text-xs text-slate-400 mt-3 leading-relaxed\">\n            Tenaga medis ahli berdedikasi tinggi dengan standar akreditasi internasional demi melayani kesembuhan optimal keluarga Anda.\n          </p>\n        </div>\n\n        {/* Right Column: Doctor Portrait List - Grid sizing depends on length of lists */}\n        <div className=\"lg:col-span-8\">\n          <div className={`grid gap-4 ${\n            filteredList.length === 1 \n              ? \"grid-cols-1 max-w-md mx-auto\" \n              : filteredList.length === 2 \n                ? \"grid-cols-1 md:grid-cols-2\" \n                : filteredList.length === 3 \n                  ? \"grid-cols-1 md:grid-cols-3\" \n                  : \"grid-cols-1 md:grid-cols-3 lg:grid-cols-4\" // support more\n          }`}>\n            \n            {filteredList.map((doc, idx) => {\n              const themeColor = avatarColors[idx % avatarColors.length];\n              const scheduleDays = Object.keys(doc.schedule);\n\n              return (\n                <motion.div\n                  key={doc.id}\n                  initial={{ opacity: 0, scale: 0.95, y: 15 }}\n                  animate={{ opacity: 1, scale: 1, y: 0 }}\n                  transition={{ delay: idx * 0.08, duration: 0.4 }}\n                  className=\"bg-white border select-none border-slate-100 rounded-2xl p-4 shadow-xl shadow-slate-100/70 hover:shadow-2xl hover:shadow-slate-200/50 hover:border-blue-100 transition-all flex flex-col justify-between\"\n                >\n                  <div>\n                    {/* Doctor Silhouette avatar placeholder block */}\n                    <div className={`w-full aspect-square rounded-xl bg-gradient-to-tr ${themeColor} flex flex-col justify-center items-center relative overflow-hidden group mb-4`}>\n                      <span className=\"text-4xl font-black font-mono tracking-tight opacity-20\">\n                        {getInitials(doc.name)}\n                      </span>\n                      <Stethoscope className=\"w-12 h-12 text-white/40 absolute group-hover:scale-110 transition-transform\" />\n                      <div className=\"absolute inset-x-0 bottom-0 bg-black/10 text-white p-2 text-center text-[10px] font-mono select-none backdrop-blur-xs\">\n                        {doc.department}\n                      </div>\n                    </div>\n\n                    <h3 className=\"text-sm font-black text-slate-800 leading-snug font-sans tracking-tight line-clamp-2\">\n                      {doc.name}\n                    </h3>\n                  </div>\n\n                  <div className=\"mt-4 pt-3 border-t border-slate-50\">\n                    <div className=\"flex items-center text-[10px] font-extrabold text-[#b0841a] uppercase tracking-wider mb-2\">\n                      <Calendar className=\"w-3.5 h-3.5 mr-1\" /> JADWAL PRAKTEK:\n                    </div>\n                    {scheduleDays.length > 0 ? (\n                      <div className=\"space-y-1\">\n                        {scheduleDays.map(day => (\n                          <div key={day} className=\"flex justify-between items-center text-[11px] text-slate-500 font-sans\">\n                            <span className=\"font-semibold\">{day}</span>\n                            <span className=\"font-mono bg-slate-55 px-1.5 py-0.5 rounded text-[10px] text-slate-500 border border-slate-100\">\n                              {doc.schedule[day]}\n                            </span>\n                          </div>\n                        ))}\n                      </div>\n                    ) : (\n                      <span className=\"text-[11px] text-slate-400 italic\">Jadwal On-Call / Sesuai Perjanjian</span>\n                    )}\n                  </div>\n                </motion.div>\n              );\n            })}\n\n            {filteredList.length === 0 && (\n              <div className=\"col-span-full py-12 text-center bg-slate-50 rounded-2xl border border-slate-100\">\n                <p className=\"text-sm text-slate-400\">Tidak ada jadwal dokter untuk spesialisasi ini saat ini.</p>\n                <p className=\"text-xs text-slate-400 mt-1\">Gunakan Admin panel untuk menambahkan atau mengupdate jadwal baru.</p>\n              </div>\n            )}\n\n          </div>\n        </div>\n\n      </div>\n\n      {/* Footer */}\n      <div className=\"flex justify-between items-center text-slate-400 text-xs\">\n        <span>#BersamaSiloam</span>\n        <span className=\"font-mono\">Page {14 + offset} / 45</span>\n      </div>\n    </div>\n  );\n}\n"
    }
