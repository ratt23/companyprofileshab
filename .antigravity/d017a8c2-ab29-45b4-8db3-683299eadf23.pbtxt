       </svg>\n      </div>\n\n      {/* Main branded presentation entry */}\n      <motion.div\n        initial={{ opacity: 0, y: 30 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.8, ease: \"easeOut\" }}\n        className=\"text-center z-10 px-8\"\n      >\n        <h1 className=\"text-6xl md:text-8xl font-sans tracking-tight font-extrabold text-[#003399]\">\n          RSU Siloam\n        </h1>\n        <p className=\"mt-4 text-sm md:text-base font-mono uppercase tracking-widest text-slate-400\">\n          Siloam Hospitals Ambon CORPORATE PRESENTATION\n        </p>\n\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          transition={{ delay: 0.6, duration: 1 }}\n          className=\"mt-12 flex justify-center items-center space-x-2\"\n        >\n          <div className=\"h-0.5 w-12 bg-amber-500 rounded-full\"></div>\n          <span className=\"text-[#c29638] font-semibold text-sm uppercase tracking-wider\">\n            Center of Excellence & Facility Presentation\n          </span>\n          <div className=\"h-0.5 w-12 bg-amber-500 rounded-full\"></div>\n        </motion.div>\n      </motion.div>\n\n      <div className=\"absolute bottom-8 left-12 text-slate-400 text-xs font-sans\">\n        #BersamaSiloam\n      </div>\n      <div className=\"absolute bottom-8 right-12 text-slate-400 text-xs font-mono\">\n        Ambon Medical Presentation \342\200\242 Press Space / Arrows\n      </div>\n    </div>\n  );\n}\n"
