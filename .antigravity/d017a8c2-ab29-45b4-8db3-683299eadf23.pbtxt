    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { motion } from \"motion/react\";\nimport { Instagram, MapPin, Phone, Globe, Star, Users, Flame, Compass } from \"lucide-react\";\n\nexport function SlideSocialMedia() {\n  return (\n    <div className=\"relative w-full h-full bg-[#fafbfc] text-slate-800 p-8 flex flex-col justify-between overflow-hidden\">\n      \n      {/* Background radial soft light to resemble Page 45 */}\n      <div className=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-sky-100/30 rounded-full filter blur-3xl pointer-events-none z-0\" />\n\n      {/* Slide Header */}\n      <div className=\"flex justify-between items-center z-10\">\n        <div>\n          <span className=\"text-2xl font-bold text-[#003399]\">RSU Siloam</span>\n          <span className=\"text-xs ml-3 text-slate-400 font-mono\">Siloam Hospitals Ambon</span>\n        </div>\n        <div>\n          <span className=\"text-xs font-bold text-[#b0841a] tracking-widest bg-amber-50 px-3 py-1 rounded-full border border-amber-150/20\">\n            CONNECT WITH US\n          </span>\n        </div>\n      </div>\n\n      {/* Main Grid: Instagram & Google My business in phone mockups */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 my-auto z-10 py-4 items-center max-w-5xl mx-auto w-full\">\n        \n        {/* Left Side: Mockup of Instagram Phone Screen */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 15 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          transition={{ duration: 0.5 }}\n          className=\"bg-white rounded-3xl p-5 border border-slate-100 shadow-2xl shadow-slate-200/50 flex flex-col justify-between space-y-4 max-w-sm mx-auto w-full relative group\"\n        >\n          {/* Accent top camera notch */}\n          <div className=\"absolute top-2.5 left-1/2 -translate-x-1/2 w-20 h-4 bg-slate-900 rounded-full\" />\n\n          <div className=\"border-b border-slate-100 pb-3 flex items-center space-x-3 mt-1.5\">\n            <div className=\"w-8 h-8 rounded-full bg-gradient-to-tr from-yellow-500 via-pink-500 to-purple-600 p-0.5 flex items-center justify-center\">\n              <div className=\"w-full h-full rounded-full bg-white flex items-center justify-center text-[10px] font-bold text-slate-800\">\n                SH\n              </div>\n            </div>\n            <div>\n              <h3 className=\"text-xs font-black text-slate-850 flex items-center\">\n                siloamambon <span className=\"w-3.5 h-3.5 bg-blue-500 rounded-full text-white flex items-center justify-center text-[8px] ml-1\">\342\234\223</span>\n              </h3>\n              <p className=\"text-[10px] text-slate-400\">Ambon, Maluku</p>\n            </div>\n          </div>\n\n          <div className=\"space-y-3\">\n            <div className=\"flex justify-around items-center text-center p-2 bg-slate-50 rounded-xl\">\n              <div>\n                <div className=\"text-xs font-black\">7.072</div>\n                <div className=\"text-[9px] text-slate-400 uppercase\">Followers</div>\n              </div>\n              <div>\n                <div className=\"text-xs font-black\">394</div>\n                <div className=\"text-[9px] text-slate-400 uppercase font-mono\">Posts</div>\n              </div>\n              <div>\n                <div className=\"text-xs font-black\">187</div>\n                <div className=\"text-[9px] text-slate-400 uppercase\">Following</div>\n              </div>\n            </div>\n\n            <p className=\"text-[11px] text-slate-600 leading-normal\">\n              Official Instagram of <span className=\"font-extrabold text-slate-800\">Siloam Hospitals Ambon</span>.<br />\n              \360\237\223\236 Emergency: 1-500-911 | WA: 0811 4788 008<br />\n              \360\237\217\245 Jl. Sultan Hasanuddin Kel. Hative Kecil, Kota Ambon, Maluku.\n            </p>\n\n            <div className=\"flex gap-2\">\n              <a\n                href=\"https://www.instagram.com/siloamambon\"\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"flex-1 text-center py-2 bg-[#002f8a] text-white text-[11px] font-bold rounded-lg flex items-center justify-center space-x-1.5 hover:bg-[#b0841a] transition-colors\"\n                referrerPolicy=\"no-referrer\"\n              >\n                <Instagram className=\"w-3.5 h-3.5\" />\n                <span>Follow @siloamambon</span>\n              </a>\n            </div>\n\n            {/* Grid images mockup */}\n            <div className=\"grid grid-cols-3 gap-1.5 pt-2\">\n              <div className=\"aspect-square bg-slate-100 rounded-lg flex flex-col justify-center items-center text-[10px] text-slate-400 font-mono border border-slate-150/40\">Post 1</div>\n              <div className=\"aspect-square bg-[#003399]/10 rounded-lg flex flex-col justify-center items-center text-[10px] text-[#003399] font-mono border border-blue-100\">Post 2</div>\n              <div className=\"aspect-square bg-slate-100 rounded-lg flex flex-col justify-center items-center text-[10px] text-slate-400 font-mono border border-slate-150/40\">Post 3</div>\n            </div>\n          </div>\n        </motion.div>\n\n        {/* Right Side: Mockup of Google My business */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 15 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          transition={{ duration: 0.5, delay: 0.15 }}\n          className=\"bg-white rounded-3xl p-5 border border-slate-100 shadow-2xl shadow-slate-200/50 flex flex-col justify-between space-y-4 max-w-sm mx-auto w-full relative group\"\n        >\n          {/* notch */}\n          <div className=\"absolute top-2.5 left-1/2 -translate-x-1/2 w-20 h-4 bg-slate-900 rounded-full\" />\n\n          <div className=\"border-b border-slate-100 pb-3 mt-1.5\">\n            <h3 className=\"text-sm font-black text-slate-800 tracking-tight leading-none mb-1\">\n              Siloam Hospitals Ambon\n            </h3>\n            <div className=\"flex items-center space-x-1\">\n              <span className=\"text-xs font-black text-amber-500\">4.8</span>\n              <div className=\"flex\">\n                {[...Array(5)].map((_, i) => (\n                  <Star key={i} className=\"w-3 h-3 text-amber-500 fill-amber-500\" />\n                ))}\n              </div>\n              <span className=\"text-[10px] text-slate-400 font-mono\">(1.5K Reviews)</span>\n            </div>\n            <p className=\"text-[10px] text-emerald-600 mt-1 font-semibold\">Rumah Sakit \342\200\242 Buka 24 Jam</p>\n          </div>\n\n          <div className=\"space-y-3\">\n            <div className=\"grid grid-cols-4 gap-2 text-center\">\n              <div className=\"p-2 bg-[#f4f7fc] rounded-lg\">\n                <Compass className=\"w-4 h-4 mx-auto text-[#003399] mb-1\" />\n                <span className=\"text-[9px] text-[#003399] font-bold\">Rute</span>\n              </div>\n              <div className=\"p-2 bg-[#f4f7fc] rounded-lg\">\n                <Phone className=\"w-4 h-4 mx-auto text-[#003399] mb-1\" />\n                <span className=\"text-[9px] text-[#003399] font-bold\">Telepon</span>\n              </div>\n              <div className=\"p-2 bg-[#f4f7fc] rounded-lg\">\n                <Globe className=\"w-4 h-4 mx-auto text-[#003399] mb-1\" />\n                <span className=\"text-[9px] text-[#003399] font-bold\">Situs</span>\n              </div>\n              <div className=\"p-2 bg-[#f4f7fc] rounded-lg\">\n                <Users className=\"w-4 h-4 mx-auto text-[#003399] mb-1\" />\n                <span className=\"text-[9px] text-[#003399] font-bold\">Bagikan</span>\n              </div>\n            </div>\n\n            <div className=\"space-y-2.5 text-xs text-slate-600\">\n              <div className=\"flex items-start space-x-2.5\">\n                <MapPin className=\"w-4 h-4 text-slate-400 shrink-0 mt-0.5\" />\n                <span>Jl. Sultan Hasanuddin, Hative Kecil, Kec. Sirimau, Kota Ambon, Maluku</span>\n              </div>\n              <div className=\"flex items-start space-x-2.5\">\n                <Phone className=\"w-4 h-4 text-slate-400 shrink-0 mt-0.5\" />\n                <span className=\"font-mono\">(0911) 3811900</span>\n              </div>\n            </div>\n\n            <div className=\"bg-slate-50 p-2.5 rounded-xl border border-slate-100 text-[10px] text-slate-500 leading-normal\">\n              \360\237\222\241 <span className=\"font-bold text-slate-700\">Google My Business:</span> Mempermudah pencarian rute kemudi ambulans serta memberikan transparansi ulasan pasien terpercaya secara publik.\n            </div>\n          </div>\n        </motion.div>\n\n      </div>\n\n      {/* Footer */}\n      <div className=\"flex justify-between items-center text-slate-400 text-xs\">\n        <span>#BersamaSiloam</span>\n        <span className=\"font-mono\">Page 45 / 45</span>\n      </div>\n    </div>\n  );\n}\n"
    }
