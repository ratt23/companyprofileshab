  file_change {
    absolute_path_uri: "file:///src/components/SlideExcelence.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { motion } from \"motion/react\";\nimport { Baby, Activity, ShieldAlert, ChevronRight } from \"lucide-react\";\n\nexport function SlideExcelence() {\n  const cards = [\n    {\n      id: \"obsgyn\",\n      title: \"OBSGYN\",\n      icon: <Baby className=\"w-12 h-12 text-[#003399]\" />,\n      stats: \"3000+ Kelahiran sejak Des 2020\",\n      description: \"Layanan persalinan modern dengan metode unggulan yang mengedepankan keamanan medis dan kenyamanan pasien.\",\n      points: [\n        \"Prosedur melahirkan dengan ERACS (Enhanced Recovery After Cesarean Surgery)\",\n        \"ILA (Intrathecal Labor Analgesia)\",\n        \"WELA (Water Birth / Alternative births)\",\n        \"Dukungan tim dokter obsgyn & bidan bersertifikat penuh\"\n      ]\n    },\n    {\n      id: \"orthopaedy\",\n      title: \"ORTHOPAEDY\",\n      icon: <Activity className=\"w-12 h-12 text-[#b0841a]\" />,\n      stats: \"Total Knee & Hip Specialist\",\n      description: \"Penanganan komprehensif cedera musculoskeletal, kelumpuhan sendi, robekan ligamen, dan patah tulang kompleks.\",\n      points: [\n        \"Prosedur Total Knee and Hip Replacement (TKR & THR)\",\n        \"Operasi tulang rekonstruksi dan minimal invasif lainnya\",\n        \"Penanganan cedera olahraga (sport injuries)\",\n        \"Fisioterapi pemulihan pasca operasi berstandar tinggi\"\n      ]\n    },\n    {\n      id: \"urology\",\n      title: \"UROLOGY\",\n      icon: <ShieldAlert className=\"w-12 h-12 text-[#0a66c2]\" />,\n      stats: \"Invasive & Non-invasive Urology\",\n      description: \"Pusat diagnosis dan pengobatan gangguan saluran kemih, batu ginjal, prostat, dan uretra menggunakan teknik mutakhir.\",\n      points: [\n        \"URS (Ureteroscopy) pemecahan batu di saluran kemih tanpa sayatan\",\n        \"ESWL (Extracorporeal Shock Wave Lithotripsy) gelombang kejut\",\n        \"TURP (Transurethral Resection of the Prostate)\",\n        \"PCNL (Percutaneous Nephrolithotomy) pembedahan minimal\"\n      ]\n    }\n  ];\n\n  return (\n    <div className=\"relative w-full h-full bg-[#f8faff] text-slate-800 p-8 flex flex-col justify-between overflow-hidden\">\n      {/* Brand logo header */}\n      <div className=\"flex justify-between items-center\">\n        <span className=\"text-2xl font-bold bg-gradient-to-r from-[#003399] to-[#0e4ca2] bg-clip-text text-transparent\">\n          RSU Siloam\n        </span>\n        <span className=\"text-sm font-semibold tracking-wider text-[#b0841a] bg-amber-50 px-3 py-1 rounded-full\">\n          INDONESIA\'S LEADING HOSPITALS\n        </span>\n      </div>\n\n      {/* Main content grid */}\n      <div className=\"my-auto\">\n        <div className=\"mb-6\">\n          <motion.h4\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            className=\"text-xs uppercase font-bold tracking-widest text-[#b0841a]\"\n          >\n            Siloam Hospitals Ambon\n          </motion.h4>\n          <motion.h2\n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5 }}\n            className=\"text-5xl md:text-6xl font-extrabold tracking-tight text-[#003399] leading-none\"\n          >\n            CENTER OF <br className=\"hidden md:inline\" />EXCELLENCE\n          </motion.h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {cards.map((card, index) => (\n            <motion.div\n              key={card.id}\n              initial={{ opacity: 0, y: 40 }}\n              animate={{ opacity: 1, y: 0 }}\n              transition={{ delay: index * 0.15, duration: 0.5 }}\n              whileHover={{ y: -8 }}\n              className=\"bg-white rounded-2xl p-6 shadow-xl shadow-slate-100 flex flex-col justify-between border border-blue-50/50 relative overflow-hidden group hover:border-blue-100 transition-all\"\n            >\n              {/* Colored top-accent bar */}\n              <div className={`absolute top-0 left-0 right-0 h-1.5 ${\n                card.id === \'obsgyn\' ? \'bg-[#003399]\' : card.id === \'orthopaedy\' ? \'bg-[#b0841a]\' : \'bg-[#0a66c2]\'\n              }`} />\n\n              <div>\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-slate-50 rounded-xl group-hover:scale-110 transition-transform\">\n                    {card.icon}\n                  </div>\n                  <span className=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-500 font-mono\">\n                    {card.stats}\n                  </span>\n                </div>\n\n                <h3 className=\"text-2xl font-extrabold text-[#002f87] mb-2\">\n                  {card.title}\n                </h3>\n                <p className=\"text-xs text-slate-500 mb-4 line-clamp-2\">\n                  {card.description}\n                </p>\n\n                <ul className=\"space-y-2\">\n                  {card.points.map((point, i) => (\n                    <li key={i} className=\"flex items-start text-xs text-slate-700\">\n                      <ChevronRight className=\"w-3.5 h-3.5 text-amber-500 mt-0.5 shrink-0 mr-1.5\" />\n                      <span>{point}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n\n              <div className=\"mt-6 pt-4 border-t border-slate-100 text-xs font-semibold text-[#003399] flex items-center justify-between pointer-events-none group-hover:text-amber-600 transition-colors\">\n                <span>Pelajari Detail Unggulan</span>\n                <ChevronRight className=\"w-4 h-4 translate-x-0 group-hover:translate-x-1 transition-transform\" />\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n\n      <div className=\"flex justify-between items-center text-slate-400 text-xs\">\n        <span>#BersamaSiloam</span>\n        <span className=\"font-mono\">Page 2 / 45</span>\n      </div>\n    </div>\n  );\n}\n"
    }
