    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { Star, Eye, ChevronRight, CheckCircle2, ShieldBadge } from \"lucide-react\";\n\nexport function SlideClinic() {\n  const [activeImageTab, setActiveImageTab] = useState(0);\n\n  const spaces = [\n    {\n      title: \"Executive Main Lounge\",\n      description: \"Lobby utama dengan pencahayaan hangat dan aksen kayu walnut mewah, memberikan atmosfir yang rileks seperti berada di ruang tunggu hotel bintang lima.\",\n      features: [\"Sistem One-Stop-Service (Konsultasi, Lab, Farmasi di satu tempat)\", \"Sajian kopi, teh premium, dan makanan ringan gratis\", \"Personal Care Officer (asisten pendamping medis pribadi)\"]\n    },\n    {\n      title: \"VIP Consultation Suits\",\n      description: \"Kamar konsultasi privat eksklusif bersuasana kedap suara yang menjamin privasi tinggi bagi pasien eksekutif saat berbicara dengan dokter penanggung jawab.\",\n      features: [\"Meja konsultasi premium\", \"Sistem rekam medis terpadu\", \"Dokter spesialis berpengalaman\"]\n    },\n    {\n      title: \"Executive Reception Portal\",\n      description: \"Konter pendaftaran terpisah tanpa antrean panjang umum, menjamin administrasi selesai sangat cepat dalam kurun waktu kurang dari 5 menit.\",\n      features: [\"Kemudahan jaminan asuransi\", \"Kasir pribadi khusus\", \"Skrining kesehatan terjadwal\"]\n    }\n  ];\n\n  const highlights = [\n    \"No Queues (Bebas Antrean Umum)\",\n    \"Pribadi & Confidential\",\n    \"Pilihan Dokter Terbaik\",\n    \"Kecepatan Pelayanan 2x Lipat\",\n    \"Alur Satu Atap Terintegrasi\"\n  ];\n\n  return (\n    <div className=\"relative w-full h-full bg-[#fafbfc] text-slate-800 p-8 flex flex-col justify-between overflow-hidden\">\n      \n      {/* Wave header lines */}\n      <div className=\"absolute right-0 top-0 pointer-events-none opacity-5\">\n        <svg className=\"w-96 h-96\" viewBox=\"0 0 100 100\">\n          <circle cx=\"100\" cy=\"0\" r=\"80\" fill=\"#003399\" />\n          <circle cx=\"100\" cy=\"0\" r=\"50\" fill=\"#b0841a\" />\n        </svg>\n      </div>\n\n      {/* Slide Header */}\n      <div className=\"flex justify-between items-center z-10\">\n        <div>\n          <span className=\"text-2xl font-bold bg-[#002f8a] bg-clip-text text-transparent\">RSU Siloam</span>\n          <span className=\"text-xs ml-3 text-slate-400 font-mono\">Executive & Premium Health Care</span>\n        </div>\n        <div className=\"flex items-center space-x-1 bg-amber-50 text-amber-700 px-3 py-1 rounded-full text-xs font-semibold\">\n          <Star className=\"w-3.5 h-3.5 fill-amber-500 text-amber-500\" />\n          <span>Executive Services Portal</span>\n        </div>\n      </div>\n\n      {/* Title */}\n      <div className=\"text-left mt-4 z-10\">\n        <h2 className=\"text-5xl font-black text-[#003399] tracking-tight leading-none\">\n          Executive Clinic\n        </h2>\n        <p className=\"text-slate-500 text-xs mt-1.5 uppercase tracking-widest font-mono\">\n          Siloam Hospitals Ambon Luxury Healing Spaces\n        </p>\n      </div>\n\n      {/* Interactive Main Body */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 my-auto z-10 items-center py-4\">\n        \n        {/* Left Side: Mockups with elegant styling and tab selection */}\n        <div className=\"lg:col-span-6 flex flex-col justify-between space-y-4\">\n          <div className=\"relative rounded-2xl bg-white border border-slate-100 p-4 shadow-2xl shadow-slate-200/50 overflow-hidden group\">\n            \n            {/* Ambient Wood-themed simulated image panel since we don\'t have static images */}\n            <div className={`h-[200px] rounded-xl relative overflow-hidden flex flex-col justify-between p-5 transition-all duration-500 bg-gradient-to-tr ${\n              activeImageTab === 0 \n                ? \"from-amber-900 via-[#825b1b] to-[#1e293b] text-amber-50\" \n                : activeImageTab === 1 \n                  ? \"from-[#0d4ea5] via-[#02316e] to-[#1e293b] text-sky-50\" \n                  : \"from-slate-700 via-slate-800 to-slate-950 text-slate-50\"\n            }`}>\n              <div className=\"absolute inset-0 bg-black/10 mix-blend-overlay\" />\n              \n              <div className=\"flex justify-between items-center z-10\">\n                <span className=\"text-[10px] font-bold tracking-widest uppercase bg-white/20 px-2.5 py-1 rounded-full border border-white/10 backdrop-blur-sm\">\n                  PORTFOLIO SHOWCASE\n                </span>\n                <span className=\"text-xs font-mono flex items-center bg-white/10 px-2 py-0.5 rounded backdrop-blur-sm\">\n                  <Eye className=\"w-3.5 h-3.5 mr-1\" /> ACTIVE VIEW\n                </span>\n              </div>\n\n              {/* Decorative timber lining vector simulation */}\n              <div className=\"absolute inset-x-0 bottom-0 h-4 bg-amber-800/20 backdrop-blur-xs flex justify-around pointer-events-none\">\n                <div className=\"w-1 h-full bg-amber-700/40\" />\n                <div className=\"w-1 h-full bg-amber-750/40\" />\n                <div className=\"w-1 h-full bg-amber-700/40\" />\n                <div className=\"w-1 h-full bg-amber-750/40\" />\n                <div className=\"w-1 h-full bg-amber-700/40\" />\n              </div>\n\n              <div className=\"z-10 bg-black/40 p-4 rounded-xl border border-white/5 backdrop-blur-md\">\n                <h4 className=\"text-lg font-black\">{spaces[activeImageTab].title}</h4>\n                <p className=\"text-[11px] opacity-90 mt-1 leading-snug\">{spaces[activeImageTab].description}</p>\n              </div>\n            </div>\n\n            {/* Bottom controllers */}\n            <div className=\"flex border-t border-slate-50 mt-4 pt-4\">\n              {spaces.map((space, idx) => (\n                <button\n                  key={idx}\n                  onClick={() => setActiveImageTab(idx)}\n                  className={`flex-1 text-center py-2.5 text-xs font-bold rounded-xl transition-all ${\n                    activeImageTab === idx\n                      ? \"bg-amber-500 text-white shadow-md shadow-amber-500/10\"\n                      : \"text-slate-500 hover:bg-slate-50 hover:text-slate-800\"\n                  }`}\n                >\n                  Area {idx + 1}\n                </button>\n              ))}\n            </div>\n\n          </div>\n        </div>\n\n        {/* Right Side: Feature bullet points */}\n        <div className=\"lg:col-span-6 flex flex-col justify-center space-y-4\">\n          <div className=\"bg-amber-50/50 border border-amber-100 rounded-2xl p-5 shadow-sm\">\n            <h4 className=\"flex items-center text-xs font-bold text-amber-700 uppercase tracking-widest mb-3\">\n              <ShieldBadge className=\"w-4 h-4 mr-1.5\" /> LUXURY HOSPITALITY FEATURES\n            </h4>\n            \n            <ul className=\"space-y-3\">\n              {spaces[activeImageTab].features.map((feature, i) => (\n                <li key={i} className=\"flex items-start text-xs text-slate-700\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5 mr-2\" />\n                  <span>{feature}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"text-[10px] font-bold uppercase tracking-widest text-[#003399] mb-2 font-mono\">\n              KEUNGGULAN UTAMA CLINIC\n            </h4>\n            <div className=\"flex flex-wrap gap-2\">\n              {highlights.map((h, i) => (\n                <span\n                  key={i}\n                  className=\"text-[11px] font-semibold bg-white border border-slate-100 shadow-sm text-[#002f8a] px-3 py-1.5 rounded-xl flex items-center\"\n                >\n                  <ChevronRight className=\"w-3 h-3 text-amber-500 mr-1\" />\n                  {h}\n                </span>\n              ))}\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Footer */}\n      <div className=\"flex justify-between items-center text-slate-400 text-xs\">\n        <span>#BersamaSiloam</span>\n        <span className=\"font-mono\">Page 9 / 45</span>\n      </div>\n    </div>\n  );\n}\n"
    }
